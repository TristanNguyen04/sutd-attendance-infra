{
  "permissions": {
    "allow": [
      "Bash(make check)",
      "Bash(make fmt)",
      "Bash(make validate)",
      "Bash(make lint)",
      "Bash(terraform fmt:*)",
      "Bash(terraform validate:*)",
      "Bash(tflint:*)"
    ],
    "ask": [
      "Bash(terraform import:*)",
      "Bash(terraform state mv:*)",
      "Bash(terraform plan:*)"
    ],
    "deny": [
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform state rm:*)",
      "Bash(terraform force-unlock:*)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  }
}
